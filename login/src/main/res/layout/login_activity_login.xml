<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".LoginActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_log_in"
        android:name="com.difft.android.login.ui.LoginFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_sign_up"
        android:name="com.difft.android.login.ui.SignUpFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/ib_login_menu"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_marginEnd="6dp"
        android:background="@null"
        android:contentDescription="@string/login_use_proxy"
        android:padding="14dp"
        android:src="@drawable/login_ic_more_vert"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/t.primary"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>