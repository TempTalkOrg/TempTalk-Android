<?xml version="1.0" encoding="UTF-8"?>
<!--
  Module-level lint config for :selector (vendored PictureSelector fork).

  Rules disabled here are stylistic / vendored-irrelevant — see #854 PR A.
  Real-bug-suspect rules (MissingPermission, PrivateApi, etc.) remain enforced
  via lint-baseline.xml and will be addressed in PR B.

  Note: ContentDescription was fixed inline via `android:contentDescription="@null"`.
  DefaultLocale was fixed inline via `Locale.ROOT`. Those rules remain enabled here.
-->
<lint>
    <issue id="RtlSymmetry" severity="ignore" />
    <issue id="RtlHardcoded" severity="ignore" />
    <issue id="Range" severity="ignore" />
    <issue id="PluralsCandidate" severity="ignore" />
    <issue id="DiscouragedApi" severity="ignore" />
    <issue id="UseKtx" severity="ignore" />
    <issue id="RelativeOverlap" severity="ignore" />
    <issue id="RecyclerView" severity="ignore" />
    <issue id="InternalInsetResource" severity="ignore" />
    <issue id="ClickableViewAccessibility" severity="ignore" />
    <issue id="SwitchIntDef" severity="ignore" />
    <issue id="SetTextI18n" severity="ignore" />
    <issue id="Overdraw" severity="ignore" />
    <issue id="InflateParams" severity="ignore" />
    <issue id="IconMissingDensityFolder" severity="ignore" />
    <issue id="AppBundleLocaleChanges" severity="ignore" />
    <issue id="Aligned16KB" severity="ignore" />

    <!-- VIBRATE permission declared by consumer modules (:chat, :call) and merged
         at APK level. Vendored PictureSelector calls Vibrator at
         PictureSelectorFragment.java:870 + PictureSelectorPreviewFragment.java:1025
         for drag-to-reorder long-press feedback. Path-scoped to keep the rule
         enforced for any new selector code. -->
    <issue id="MissingPermission">
        <ignore path="src/main/java/com/difft/android/selector/PictureSelectorFragment.kt" />
        <ignore path="src/main/java/com/difft/android/selector/PictureSelectorPreviewFragment.kt" />
    </issue>
</lint>
