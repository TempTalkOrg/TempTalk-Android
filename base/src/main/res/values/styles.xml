<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    

    
    <style name="Animation.Chative.Activity" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/page_push_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/page_push_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_pop_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/page_pop_exit</item>
    </style>

    <style name="CustomBottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@color/bg1</item>
    </style>

    <declare-styleable name="uikit_verify_code">
        <attr name="verifyTitle" format="string" />
        <attr name="hideInput" format="boolean" />
        <attr name="canDirectInput" format="boolean" />
    </declare-styleable>
    <declare-styleable name="VerificationCodeView">
        <attr name="codeLength" format="integer" />
        <attr name="boxSize" format="dimension" />
        <attr name="spacing" format="dimension" />
        <attr name="boxColor" format="color" />
    </declare-styleable>

    <style name="Text_Headline1">
        <item name="android:textSize">28sp</item>
    </style>

    <style name="Text_Headline1.H40">
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text_Headline2">
        <item name="android:textSize">24sp</item>
    </style>

    <style name="Text_Headline2.H34">
        <item name="android:layout_height">34dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text_Headline3">
        <item name="android:textSize">20sp</item>
    </style>

    <style name="Text_Headline3.H28">
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text_Headline4">
        <item name="android:textSize">18sp</item>
    </style>


    <style name="Text_Headline4.H28">
        <item name="android:layout_height">28dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
    </style>


    <style name="Text_Subtitle">
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Text_SubtitleBold">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text_Subtitle1">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Text_Subtitle1Bold">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text_Subtitle1.H24">
        <item name="android:layout_height">24dp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:includeFontPadding">false</item>
    </style>

</resources>