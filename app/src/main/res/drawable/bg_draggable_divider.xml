<?xml version="1.0" encoding="utf-8"?>
<!--
    Background for the draggable dual-pane divider (floating overlay).

    Layer order (bottom-up):
      1. Ripple (touch feedback; only triggered by touches in the center band per
         DraggableDividerView.isInActiveBand)
      2. Center drag handle pill (6dp x 56dp, fully rounded capsule) — affordance
         mirroring Signal Android's AppPaneDragHandle (Material 3 Adaptive),
         using @color/icon for theme-adaptive contrast (dark grey on light theme,
         light grey on dark theme).

    No full-height line: pane separation is implicit from list/detail backgrounds.

    The mask on the ripple keeps feedback inside the view bounds.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <ripple android:color="?android:attr/colorControlHighlight">
            <item android:id="@android:id/mask">
                <shape android:shape="rectangle">
                    <solid android:color="@android:color/white" />
                </shape>
            </item>
        </ripple>
    </item>

    <item android:gravity="center">
        <shape android:shape="rectangle">
            <size
                android:width="6dp"
                android:height="56dp" />
            <corners android:radius="28dp" />
            <solid android:color="@color/icon" />
        </shape>
    </item>

</layer-list>
