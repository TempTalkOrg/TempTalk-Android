<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="InconsistentLayout">

    
    <FrameLayout
        android:id="@+id/list_pane"
        android:layout_width="@dimen/dual_pane_list_default_width"
        android:layout_height="0dp"
        android:tag="@string/dual_pane_band"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        
        <FrameLayout
            android:id="@+id/list_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/index_viewpager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            
            <FrameLayout
                android:id="@+id/home_tab_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingBottom="28dp">

                <androidx.compose.ui.platform.ComposeView
                    android:id="@+id/home_tab_capsule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal" />
            </FrameLayout>
        </FrameLayout>

        
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/list_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:visibility="gone" />

    </FrameLayout>

    
    <FrameLayout
        android:id="@+id/detail_pane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/list_pane"
        app:layout_constraintTop_toTopOf="parent">

        
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/empty_detail_view"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/login_logo_with_name"
            android:tint="@color/t.disable"
            android:visibility="visible" />

    </FrameLayout>


    
    <com.difft.android.views.DraggableDividerView
        android:id="@+id/divider_pane"
        android:layout_width="24dp"
        android:layout_height="0dp"
        android:layout_marginStart="-12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/list_pane"
        app:layout_constraintTop_toTopOf="parent" />

    

</androidx.constraintlayout.widget.ConstraintLayout>