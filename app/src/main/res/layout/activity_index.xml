<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- List content: the tab pager plus the floating home tab capsule over its bottom edge.
         The same list_content / home_tab_bar ids as the two-pane layout keep IndexActivity's
         width-freeze and coverage logic layout-agnostic. -->
    <FrameLayout
        android:id="@+id/list_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Keep distinct from :chat's @id/viewpager — ids merge by name, and ContactsFragment
             nests its own pager here, so a shared id collides in the window view-state map.
             Extends to the window bottom: the pages scroll underneath the capsule and pad
             themselves by DualPaneHost.homeTabBarObstructionPx. -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/index_viewpager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:nestedScrollingEnabled="true" />

        <!-- Floating home tab capsule + search circle (HomeTabCapsule). Bottom padding = the
             28dp gap iOS keeps, raised above a 3-button navigation bar by IndexActivity;
             clipToPadding off so the shadow draws into that gap. -->
        <FrameLayout
            android:id="@+id/home_tab_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="28dp">

            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/home_tab_capsule"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal" />
        </FrameLayout>
    </FrameLayout>

    <!-- Full-window list-pane layer (search, folded groups) over the list and the tab capsule;
         the detail layer below stays on top of it. ListPaneLayer shows it while the layer is up;
         the same id as the two-pane layout lets a fold/unfold recreation restore the layer host
         into either tree. Clickable so touches never reach the covered list. -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/list_layer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg1"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Full-window detail layer over the list and the tab bar (declared last, drawn on top).
         PaneNavigator shows it while the current tab's detail stack is non-empty. The same
         fragment_container_detail id as the two-pane layout lets a fold/unfold recreation
         restore the per-tab stacks into either tree. Clickable so touches never reach the
         covered list; not itself an accessibility node (its pages are). -->
    <FrameLayout
        android:id="@+id/detail_pane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/bg1"
        android:clickable="true"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragment_container_detail"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>