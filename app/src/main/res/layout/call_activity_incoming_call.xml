<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg1"
    android:filterTouchesWhenObscured="true"
    tools:ignore="Overdraw">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/window_zoom_out"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/chat_ic_window_zoom_out"
        android:tint="@color/icon"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.difft.android.chat.common.AvatarView
            android:id="@+id/caller_avatar"
            android:layout_width="96dp"
            android:layout_height="96dp" />

        <TextView
            android:id="@+id/caller_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/t.primary"
            android:textSize="16sp"
            tools:text="张三" />

        <TextView
            android:id="@+id/tip_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/t.primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!--
        Unlocked phone in use: reject / accept tap buttons, each a fixed 72dp circle centred in its
        half of the row (the hit area used to be the whole half-width slot, which a pocket brush could
        land on anywhere).
    -->
    <com.difft.android.call.ui.incoming.IncomingCallControlsView
        android:id="@+id/answer_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        app:icc_acceptIcon="@mipmap/chat_ic_call_accept"
        app:icc_rejectIcon="@mipmap/chat_ic_call_reject"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!--
        Screen lit by the call itself (display was off or keyguard up): single-track slider, drag
        right to answer / left to decline (design: track 28dp from the sides, 72dp from the bottom).
        Shown instead of answer_controls, never alongside it.
    -->
    <com.difft.android.call.ui.incoming.IncomingCallSliderView
        android:id="@+id/answer_slider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="28dp"
        android:layout_marginBottom="72dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
