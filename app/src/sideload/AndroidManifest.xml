<?xml version="1.0" encoding="utf-8"?>
<!-- In-app APK self-update, merged only into the sideload channels (official, insider). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <service
            android:name="com.difft.android.setting.AppUpgradeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name="com.difft.android.setting.AppUpgradeRetryReceiver"
            android:exported="false" />
    </application>
</manifest>
