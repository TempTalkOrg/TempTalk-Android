<?xml version="1.0" encoding="utf-8"?>

<com.difft.android.chat.recent.ChatListSwipeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    
    
    <LinearLayout
        android:id="@+id/swipe_start_actions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/chat_list_swipe_action_inset"
        android:paddingEnd="@dimen/chat_list_swipe_action_gap">

        <LinearLayout
            android:id="@+id/action_read"
            android:layout_width="@dimen/chat_list_swipe_action_width"
            android:layout_height="wrap_content"
            android:background="@drawable/chat_swipe_action_bg"
            android:backgroundTint="@color/chat_swipe_read"
            android:gravity="center"
            android:minHeight="@dimen/chat_list_swipe_action_min_height"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/chat_list_swipe_action_label_padding"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/action_read_icon"
                android:layout_width="@dimen/chat_list_swipe_action_icon"
                android:layout_height="@dimen/chat_list_swipe_action_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/chat_icon_mark_read"
                app:tint="@color/t.white" />

            <TextView
                android:id="@+id/action_read_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chat_list_swipe_action_label_gap"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                tools:text="@string/chat_action_mark_read"
                android:textColor="@color/t.white"
                android:textSize="@dimen/chat_list_swipe_action_label" />
        </LinearLayout>
    </LinearLayout>

    
    <LinearLayout
        android:id="@+id/swipe_end_actions"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/chat_list_swipe_action_inset">

        <LinearLayout
            android:id="@+id/action_pin"
            android:layout_width="@dimen/chat_list_swipe_action_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/chat_list_swipe_action_gap"
            android:background="@drawable/chat_swipe_action_bg"
            android:backgroundTint="@color/bg.tooltip"
            android:gravity="center"
            android:minHeight="@dimen/chat_list_swipe_action_min_height"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/chat_list_swipe_action_label_padding"
            android:paddingVertical="4dp">

            <ImageView
                android:id="@+id/action_pin_icon"
                android:layout_width="@dimen/chat_list_swipe_action_icon"
                android:layout_height="@dimen/chat_list_swipe_action_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/chat_icon_stick"
                app:tint="@color/t.white" />

            <TextView
                android:id="@+id/action_pin_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chat_list_swipe_action_label_gap"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                tools:text="@string/chat_stick"
                android:textColor="@color/t.white"
                android:textSize="@dimen/chat_list_swipe_action_label" />
        </LinearLayout>

        
        <LinearLayout
            android:id="@+id/action_focus"
            android:layout_width="@dimen/chat_list_swipe_action_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/chat_list_swipe_action_gap"
            android:background="@drawable/chat_swipe_action_focus_bg"
            android:gravity="center"
            android:minHeight="@dimen/chat_list_swipe_action_min_height"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/chat_list_swipe_action_label_padding"
            android:paddingVertical="4dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/action_focus_icon"
                android:layout_width="@dimen/chat_list_swipe_action_icon"
                android:layout_height="@dimen/chat_list_swipe_action_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/chat_ic_focus"
                app:tint="@color/t.white" />

            <TextView
                android:id="@+id/action_focus_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chat_list_swipe_action_label_gap"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                tools:text="@string/focus_list_swipe_focus"
                android:textColor="@color/t.white"
                android:textSize="@dimen/chat_list_swipe_action_label" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/action_delete"
            android:layout_width="@dimen/chat_list_swipe_action_width"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/chat_list_swipe_action_gap"
            android:background="@drawable/chat_swipe_action_bg"
            android:backgroundTint="@color/error"
            android:gravity="center"
            android:minHeight="@dimen/chat_list_swipe_action_min_height"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/chat_list_swipe_action_label_padding"
            android:paddingVertical="4dp">

            <ImageView
                android:layout_width="@dimen/chat_list_swipe_action_icon"
                android:layout_height="@dimen/chat_list_swipe_action_icon"
                android:importantForAccessibility="no"
                android:src="@drawable/chat_message_action_delete"
                app:tint="@color/t.white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/chat_list_swipe_action_label_gap"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/me_delete"
                android:textColor="@color/t.white"
                android:textSize="@dimen/chat_list_swipe_action_label" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/swipe_foreground"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg1"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="10dp">

        <FrameLayout
            android:id="@+id/frame_layout_avatar"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="16dp">

            <com.difft.android.chat.common.GroupAvatarView
                android:id="@+id/imageview_group_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:src="@tools:sample/avatars" />

            <com.difft.android.chat.common.AvatarView
                android:id="@+id/imageview_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:src="@tools:sample/avatars" />
        </FrameLayout>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/textview_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:lines="1"
                        android:textColor="@color/t.primary"
                        android:textSize="16sp"
                        app:layout_constrainedWidth="true"
                        app:layout_constraintEnd_toStartOf="@+id/imageview_bot_badge"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="Design UED Design UED Design UED" />

                    <ImageView
                        android:id="@+id/imageview_bot_badge"
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="4dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/chat_ic_official_bot_badge"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/textview_label"
                        app:layout_constraintEnd_toStartOf="@+id/timer_row"
                        app:layout_constraintStart_toEndOf="@+id/textview_label"
                        app:layout_constraintTop_toTopOf="@id/textview_label"
                        tools:visibility="visible" />

                    <LinearLayout
                        android:id="@+id/timer_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/textview_label"
                        app:layout_constraintEnd_toStartOf="@+id/imageview_fold_resume"
                        app:layout_constraintStart_toEndOf="@+id/imageview_bot_badge"
                        app:layout_constraintTop_toTopOf="@id/textview_label"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/imageview_timer"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/chat_ic_hourglass"
                            app:tint="@color/t.third" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/textview_timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:includeFontPadding="false"
                            android:singleLine="true"
                            android:textColor="@color/t.third"
                            android:textSize="12sp"
                            tools:text="7d" />
                    </LinearLayout>

                    
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/imageview_fold_resume"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginStart="6dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/chat_ic_focus"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/textview_label"
                        app:layout_constraintEnd_toStartOf="@+id/textview_fold_resume"
                        app:layout_constraintStart_toEndOf="@+id/timer_row"
                        app:layout_constraintTop_toTopOf="@id/textview_label"
                        app:tint="@color/t.third"
                        tools:visibility="visible" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/textview_fold_resume"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:includeFontPadding="false"
                        android:lines="1"
                        android:textColor="@color/t.third"
                        android:textSize="12sp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@id/textview_label"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/imageview_fold_resume"
                        app:layout_constraintTop_toTopOf="@id/textview_label"
                        tools:text="18:00 恢复"
                        tools:visibility="visible" />
                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/textview_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:lines="1"
                    android:textColor="@color/t.third"
                    android:textSize="12sp"
                    tools:text="10:09 AM" />

                
                <TextView
                    android:id="@+id/call_bar_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/chat_list_meeting_capsule_bg"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:paddingHorizontal="6dp"
                    android:textColor="@color/on_primary"
                    android:textSize="12sp"
                    android:visibility="gone"
                    tools:text="00:21"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                
                
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageview_sending"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/chat_icon_message_sending_new"
                    android:visibility="gone"
                    app:tint="@color/t.third"
                    tools:visibility="visible" />

                
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/textview_at"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:ellipsize="end"
                    android:lines="1"
                    android:textColor="@color/t.error"
                    android:textSize="14sp"
                    tools:text="[@You]" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/textview_detail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:lines="1"
                    android:textColor="@color/t.third"
                    android:textSize="14sp"
                    tools:text="Manta :Diana@binan...Manta :Diana@binan...Manta :Diana@binan..." />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/textview_missed_number"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:background="@drawable/chat_missing_number_bg"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:lines="1"
                    android:minWidth="18dp"
                    android:minHeight="18dp"
                    android:padding="3dp"
                    android:textColor="@color/white"
                    android:textSize="10sp"
                    android:visibility="gone"
                    tools:ignore="SmallSp"
                    tools:text="99+"
                    tools:visibility="visible" />

                
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageview_focus"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/chat_ic_focus"
                    android:visibility="gone"
                    app:tint="@color/t.disable" />

                
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/imageview_pinned"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/chat_ic_list_pinned"
                    android:visibility="gone"
                    app:tint="@color/t.disable" />

            </LinearLayout>

            
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textview_focus_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="16dp"
                android:ellipsize="end"
                android:lines="1"
                android:textColor="@color/t.third"
                android:textSize="14sp"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/textview_focus_line3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="16dp"
                android:ellipsize="end"
                android:lines="1"
                android:textColor="@color/t.third"
                android:textSize="14sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

</com.difft.android.chat.recent.ChatListSwipeLayout>
