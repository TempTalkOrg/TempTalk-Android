<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/title_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:importantForAccessibility="no">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title_container_inner"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ib_back"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@null"
            android:padding="12dp"
            android:src="@drawable/chative_ic_back"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/icon" />

        
        <LinearLayout
            android:id="@+id/title_pill"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/chat_header_control_size"
            android:layout_marginStart="@dimen/chat_header_title_gap"
            android:layout_marginEnd="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/actions_capsule"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toEndOf="@id/ib_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_goneMarginStart="@dimen/chat_header_title_margin_start_no_back">

            <com.difft.android.chat.common.GroupAvatarView
                android:id="@+id/imageview_title_avatar"
                android:layout_width="@dimen/chat_header_avatar_size"
                android:layout_height="@dimen/chat_header_avatar_size"
                android:layout_marginEnd="8dp"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/title_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/name_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:singleLine="true"
                        android:text="@string/new_group"
                        android:textColor="@color/t.primary"
                        android:textSize="16sp"
                        tools:text="GroupName GroupName GroupName GroupName" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/textview_group_member_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:singleLine="true"
                        android:textColor="@color/t.primary"
                        android:textSize="16sp"
                        tools:text="(100)" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/timer_row"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/chat_ic_hourglass"
                        app:tint="@color/t.third" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/textview_timer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:singleLine="true"
                        android:textColor="@color/t.third"
                        android:textSize="12sp"
                        tools:text="7d" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/actions_capsule"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/chat_header_control_size"
            android:layout_marginEnd="@dimen/chat_header_edge_inset"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/button_call"
                android:layout_width="@dimen/chat_header_control_size"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/chat_fragment_header_call" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/imageview_add_member"
                android:layout_width="@dimen/chat_header_control_size"
                android:layout_height="match_parent"
                android:clickable="true"
                android:focusable="true"
                android:padding="10dp"
                android:src="@drawable/chat_icon_create_group"
                android:visibility="gone"
                app:tint="@color/icon"
                tools:visibility="visible" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_view_pinned_messages"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_marginBottom="4dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title_container_inner"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
