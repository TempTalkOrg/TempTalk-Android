<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.difft.android.base.ui.glass.GlassRecyclerView
        android:id="@+id/recyclerViewMessage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingVertical="@dimen/chat_message_list_edge_padding"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/cv_day_time"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginTop="@dimen/chat_message_list_chrome_gap"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_day_time"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:lines="1"
            android:paddingHorizontal="12dp"
            android:textColor="@color/t.primary"
            android:textSize="12sp"
            app:lineHeight="16sp"
            tools:text="FRI ,DEC 25" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_at"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/cl_to_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <FrameLayout
            android:id="@+id/cv_at"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/chat_btn_at"
                app:tint="@color/info" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tv_at_count"
            android:elevation="2dp"
            android:outlineProvider="none"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="3dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_at_count_text"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:background="@drawable/chat_floating_button_flag_bg"
                android:gravity="center"
                android:textColor="@color/on_primary"
                android:textSize="7sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:ignore="SmallSp"
                tools:text="13" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_to_bottom"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_margin="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:visibility="visible">

        <FrameLayout
            android:id="@+id/cv_to_bottom"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_to_bottom"
                android:layout_width="20dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/chat_button_to_bottom"
                app:tint="@color/primary" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/tv_unread_count"
            android:elevation="2dp"
            android:outlineProvider="none"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="3dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_unread_count_text"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/chat_floating_button_flag_bg"
                android:gravity="center"
                android:textColor="@color/on_primary"
                android:textSize="7sp"
                tools:ignore="SmallSp"
                tools:text="13" />
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_view_loading"
        android:layout_width="110dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        android:clickable="false"
        android:duplicateParentState="true"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:lottie_loop="true" />
</androidx.constraintlayout.widget.ConstraintLayout>