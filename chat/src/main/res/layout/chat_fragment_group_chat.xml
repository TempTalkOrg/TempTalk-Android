<?xml version="1.0" encoding="utf-8"?>
<com.difft.android.base.widget.InsetAwareConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    app:animateKeyboardChanges="true">

    <include layout="@layout/layout_system_ui_guidelines" />

    
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container_view_contents"
        android:name="com.difft.android.chat.ui.ChatMessageListFragment"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:tag="chatMessageListFragment"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout="@layout/chat_fragment_message_list" />

    
    <Space
        android:id="@+id/top_inset_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    
    <com.difft.android.chat.ui.ChatTopFadeView
        android:id="@+id/chat_top_fade"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/chat_top_fade_tail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    
    <Space
        android:id="@+id/chat_top_fade_tail"
        android:layout_width="0dp"
        android:layout_height="@dimen/chat_top_fade_tail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragment_container_view_header" />

    
    <com.difft.android.chat.ui.SafeFrameLayout
        android:id="@+id/fragment_container_view_call"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_inset_spacer"
        tools:layout="@layout/chat_fragment_header_call" />

    
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container_view_header"
        android:name="com.difft.android.chat.group.GroupChatHeaderFragment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/fragment_container_view_call" />

    
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/fragment_container_view_input"
        android:name="com.difft.android.chat.ui.ChatMessageInputFragment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:tag="chatMessageInputFragment"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:layout="@layout/chat_fragment_input" />

    
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_voice_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:visibility="visible">

        <View
            android:id="@+id/v_voice_record_bg"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="60dp"
            android:background="@drawable/voice_record_bg"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:visibility="visible" />

        <com.difft.android.chat.widget.VoiceRecorderView
            android:id="@+id/v_voice_recorder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/include_full_input"
        layout="@layout/layout_chat_full_input" />

</com.difft.android.base.widget.InsetAwareConstraintLayout>
