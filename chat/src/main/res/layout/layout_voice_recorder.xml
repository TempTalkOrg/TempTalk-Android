<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_stop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingHorizontal="8dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:textColor="@color/t.primary.night"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/ll_action_buttons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="10dp"
        tools:text="Recording will stop in 3 seconds"
        tools:visibility="visible" />

    <!-- 双按钮容器 -->
    <LinearLayout
        android:id="@+id/ll_action_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/ll_record"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <!-- Cancel 按钮列 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_cancel_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/chat_voice_release_to_cancel"
                android:textColor="@color/t.primary"
                android:textSize="12sp"
                android:visibility="invisible"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/btn_cancel"
                android:layout_width="140dp"
                android:layout_height="72dp"
                android:background="@drawable/chat_voice_pill_bg_gray"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="24dp">

                <ImageView
                    android:id="@+id/iv_cancel_icon"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_close"
                    app:tint="@color/white" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/chat_voice_cancel"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <android.widget.Space
            android:layout_width="32dp"
            android:layout_height="0dp" />

        <!-- Add effect 按钮列 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/tv_effect_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/chat_voice_release_to_send"
                android:textColor="@color/t.primary"
                android:textSize="12sp"
                android:visibility="invisible"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/btn_add_effect"
                android:layout_width="140dp"
                android:layout_height="72dp"
                android:background="@drawable/chat_voice_pill_bg_gray"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/tv_effect_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    tools:text="✨ Voice Effect" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 录音按钮 -->
    <LinearLayout
        android:id="@+id/ll_record"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginStart="88dp"
        android:layout_marginEnd="44dp"
        android:background="@drawable/chat_msg_input_bg"
        android:gravity="center_horizontal"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginTop="0dp">

        <!-- 波形动画控件 -->
        <com.difft.android.chat.widget.WaveformView
            android:id="@+id/waveform_view"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/record_button"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/chat_voice_hold_to_talk"
            android:textColor="@color/t.primary"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
