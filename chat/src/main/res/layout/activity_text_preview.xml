<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg1"
    tools:ignore="Overdraw">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="@dimen/detail_close_button_content_inset">

        <FrameLayout
            android:id="@+id/contentWrapper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.difft.android.chat.ui.textpreview.SelectableTextView
                android:id="@+id/textContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="28dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:gravity="center_horizontal"
                android:textColor="@color/t.primary"
                android:textSize="24sp"
                android:lineSpacingExtra="12sp"
                tools:text="预览文本内容" />

        </FrameLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- Floating close button (bottom-center), shared with every message detail page. Touch
         handling in TextPreviewActivity routes any gesture starting on this button straight to
         super.dispatchTouchEvent, so it never interferes with long-press word selection /
         drag-to-select on the text. -->
    <com.difft.android.base.widget.DetailCloseButtonView
        android:id="@+id/btn_close"
        android:layout_width="@dimen/detail_close_button_size"
        android:layout_height="@dimen/detail_close_button_size"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="@dimen/detail_close_button_margin" />

</FrameLayout>
