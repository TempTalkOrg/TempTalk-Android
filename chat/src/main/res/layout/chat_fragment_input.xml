<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:focusable="false"
    android:importantForAccessibility="no"
    tools:ignore="Overdraw">

    

    <LinearLayout
        android:id="@+id/cl_send_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">

        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_at"
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_at"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:paddingHorizontal="16dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:itemCount="5"
                tools:listitem="@layout/layout_item_contact_at" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_at_close"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="15dp"
                android:src="@drawable/chat_icon_close"
                android:tint="@color/icon"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        
        <LinearLayout
            android:id="@+id/quoteZone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="8dp"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:visibility="gone"
            tools:visibility="visible">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@drawable/chat_msg_quote_flag" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/t.secondary"
                    android:textSize="12sp"
                    tools:text="LV F" />

                <TextView
                    android:id="@+id/quoteText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:lines="1"
                    android:textColor="@color/t.secondary"
                    android:textSize="12sp"
                    tools:text="LV F" />

            </LinearLayout>

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/quoteThumbnail"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:src="@tools:sample/avatars"
                tools:visibility="visible" />

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/quoteDelete"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/chat_icon_delete_msg_quote" />

        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingVertical="8dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_left_actions"
                android:layout_width="44dp"
                android:layout_height="0dp"
                android:layout_marginStart="@dimen/chat_input_edge_inset"
                android:clipChildren="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cl_input_content">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_full_input_open"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/chat_input_arrow_up"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent" />

                
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_left_buttons"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/button_more_actions"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/chat_action_more"
                        android:enabled="false"
                        android:padding="10dp"
                        android:src="@drawable/chat_more_actions"
                        android:tint="@color/icon" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_input_content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/chat_input_control_gap"
                android:layout_marginEnd="@dimen/chat_input_control_gap"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/cl_right_actions"
                app:layout_constraintStart_toEndOf="@+id/cl_left_actions"
                app:layout_goneMarginEnd="@dimen/chat_input_edge_inset"
                app:layout_goneMarginStart="@dimen/chat_input_edge_inset">

                <com.difft.android.chat.widget.RichContentEditText
                    android:id="@+id/edittext_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="@string/chat_message_input_hint"
                    android:imeOptions="flagNoExtractUi"
                    android:maxLines="5"
                    android:minHeight="44dp"
                    android:minLines="1"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/t.primary"
                    android:textColorHint="@color/t.disable"
                    android:textSize="16sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/iv_confidential"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_confidential"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/chat_btn_confidential_mode_disable"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_right_actions"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="44dp"
                android:layout_height="0dp"
                android:layout_marginEnd="@dimen/chat_input_edge_inset"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/cl_input_content">

                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_confidential_right"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:padding="10dp"
                    android:src="@drawable/chat_btn_confidential_mode_disable"
                    android:visibility="gone"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_right_buttons"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    
                    <androidx.appcompat.widget.AppCompatImageView
                        android:id="@+id/button_submit"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/chat_send"
                        android:enabled="false"
                        android:padding="10dp"
                        android:src="@drawable/chat_ic_send_arrow"
                        android:visibility="invisible" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_chat_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bg1"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/gif_panel_compose"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_friends"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/bg1"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible">

        <View
            android:id="@+id/v_friends_top_line"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline"
            android:background="@color/divider"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tv_found_you"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:text="@string/chat_do_not_trust_warning"
            android:textColor="@color/t.primary"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@+id/v_friends_top_line" />

        <LinearLayout
            android:id="@+id/ll_friends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/tv_found_you"
            app:layout_constraintBottom_toBottomOf="parent">

            <com.difft.android.base.widget.DifftButtonView
                android:id="@+id/tv_ignore"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:layout_weight="1"
                android:text="@string/contact_ignore"
                app:difft_buttonSize="large"
                app:difft_buttonVariant="secondary"
                app:layout_constraintTop_toTopOf="parent" />

            <com.difft.android.base.widget.DifftButtonView
                android:id="@+id/tv_accept"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/contact_request_accept"
                app:difft_buttonSize="large"
                app:layout_constraintTop_toTopOf="parent" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tv_unblock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg1"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="16dp"
        android:text="@string/contact_unblock_users"
        android:textColor="@color/primary"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/combineForward"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>