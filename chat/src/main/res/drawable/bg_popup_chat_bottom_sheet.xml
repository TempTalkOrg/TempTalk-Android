<?xml version="1.0" encoding="utf-8"?>
<!-- Popup-chat sheets only (ChatPopupActivity / GroupChatPopupActivity). Deliberately bg1, not the
     app-wide bg.popup: the hosted chat fragments are page/popup dual-mode and paint bg1 themselves,
     so a different container colour would show as a two-tone seam in dark mode (issue #1201). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/bg1" />
    <corners
        android:topLeftRadius="16dp"
        android:topRightRadius="16dp" />
</shape>