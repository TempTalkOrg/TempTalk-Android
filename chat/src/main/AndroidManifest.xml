<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="com.sec.android.provider.badge.permission.READ" />
    <uses-permission android:name="com.sec.android.provider.badge.permission.WRITE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission
        android:name="android.permission.DETECT_SCREEN_CAPTURE"
        android:minSdkVersion="34" />

    <uses-sdk
        android:minSdkVersion="24"
        tools:overrideLibrary="org.difft.android.rust_encryption_sdk" />

    <application android:supportsRtl="true">
        <activity
            android:name=".ui.ChatActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing|stateHidden" />
        <activity
            android:name=".ui.ChatForwardMessageActivity"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:theme="@style/Theme.TT.TransparentActivity" />
        <activity
            android:name=".ui.ChatPopupActivity"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:theme="@style/Theme.TT.TransparentActivity"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".group.GroupChatPopupActivity"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:theme="@style/Theme.TT.TransparentActivity"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <service
            android:name=".jobmanager.JobSchedulerScheduler$SystemService"
            android:enabled="true"
            android:permission="android.permission.BIND_JOB_SERVICE"
            tools:ignore="NewApi" />

        <activity
            android:name=".group.GroupChatContentActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustNothing|stateHidden" />

        <activity
            android:name=".contacts.groupcard.GroupCardActivity"
            android:exported="false"
            android:theme="@style/Theme.TT.TransparentActivity"
            android:windowSoftInputMode="adjustNothing|stateHidden" />
        <activity
            android:name=".contacts.contactsdetail.ContactDetailActivity"
            android:theme="@style/Theme.TT.TransparentActivity"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".group.CreateGroupActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false" />
        <activity
            android:name=".group.GroupInfoActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".group.GroupGlobalNotificationSettingsActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false" />
        <activity
            android:name=".group.GroupNotificationSettingsActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false" />

        <activity
            android:name=".focus.settings.FocusOthersNotifyActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false" />

        <activity
            android:name=".focus.settings.MuteExceptionsActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false" />

        <activity
            android:name=".focus.settings.FocusGroupPickerActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false" />
        <activity
            android:name=".focus.settings.FocusGroupPickerShellActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".group.GroupMembersSearchActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize" />
        <activity
            android:name=".group.GroupManagementActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false" />
        <activity
            android:name=".group.GroupModeratorsManagementActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false" />
        <activity
            android:name=".group.GroupSelectMemberActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false" />
        <activity
            android:name=".setting.ChatArchiveSettingsActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".setting.SaveToPhotosSettingsActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".setting.translate.TranslateSettingsActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:launchMode="singleTop" />
        <activity
            android:name=".ui.SingleChatSettingActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ui.GroupInCommonActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false" />
        <activity
            android:name=".ui.EmojiReactionActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false" />
        <activity
            android:name=".ui.textpreview.TextPreviewActivity"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:theme="@style/Theme.TextPreview" />
        <activity
            android:name=".ui.MessageDetailActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false" />
        <activity
            android:name=".mediasend.v2.MediaSelectionActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <activity
            android:name=".presend.FilePreSendActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden" />

        <activity
            android:name=".search.SearchMessageActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <activity
            android:name=".invite.InviteCodeActivity"
            android:screenOrientation="locked"
            android:configChanges="touchscreen|keyboard|keyboardHidden|orientation|screenLayout|screenSize"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <receiver
            android:name=".util.MessageNotificationUtil$NotificationDismissReceiver"
            android:exported="false" />

        
        <receiver
            android:name=".util.ClearClipboardAlarmReceiver"
            android:exported="false" />

        
        
        <activity
            android:name=".util.NotificationTrampolineActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".common.StopCriticalAlertSoundReceiver"
            android:exported="false" />

        
        <receiver
            android:name=".messages.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        
        <receiver
            android:name=".messages.ServiceCheckReceiver"
            android:enabled="true"
            android:exported="false" />

        <service
            android:name=".messages.MessageForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging"
            android:stopWithTask="false" />

        
        <provider
            android:name=".media.EncryptedAttachmentProvider"
            android:authorities="${applicationId}.encryptedattachment"
            android:exported="false"
            android:grantUriPermissions="true" />

        
        <provider
            android:name=".media.FavoriteEncryptedAttachmentProvider"
            android:authorities="${applicationId}.favoriteattachment"
            android:exported="false"
            android:grantUriPermissions="true" />

        
        <provider
            android:name=".media.AvatarEncryptedProvider"
            android:authorities="${applicationId}.avatarcache"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>

    <queries>
        
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.miui.powerkeeper" />
        
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.powersaving" />
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.item/event" />
        </intent>
    </queries>

</manifest>